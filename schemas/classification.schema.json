{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icare.local/schemas/classification.schema.json",
  "title": "IcareRuleClassification",
  "description": "Sortie structurée d'une classification de règle ICARE.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "justification",
    "evidence",
    "confidence",
    "manual_review",
    "theme",
    "keywords",
    "diplomas",
    "institutions",
    "countries",
    "prerequisites",
    "granted_value",
    "dossier_variables"
  ],
  "$defs": {
    "shortList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 200 },
      "maxItems": 10
    }
  },
  "properties": {
    "category": {
      "type": "string",
      "enum": ["Déterministe", "Qualitative", "Hybride"]
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "minItems": 0,
      "maxItems": 6
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "manual_review": {
      "type": "boolean"
    },
    "theme": {
      "type": "string",
      "description": "Thème de la règle (libre en découverte, liste fermée si `classification.themes` est défini)."
    },
    "keywords": { "$ref": "#/$defs/shortList" },
    "diplomas": { "$ref": "#/$defs/shortList" },
    "institutions": { "$ref": "#/$defs/shortList" },
    "countries": { "$ref": "#/$defs/shortList" },
    "prerequisites": { "$ref": "#/$defs/shortList" },
    "granted_value": {
      "type": ["string", "null"],
      "maxLength": 200
    },
    "dossier_variables": { "$ref": "#/$defs/shortList" }
  }
}
