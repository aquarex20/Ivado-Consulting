# Copier ce fichier vers `.env` et remplir les valeurs.
# Ne jamais committer les vraies clés.

# Azure OpenAI --------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<votre-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<clef-secrete>
AZURE_OPENAI_API_VERSION=2024-08-01-preview
# Nom du deployment (pas le nom du modèle)
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Chemins facultatifs (sinon config/settings.yaml est utilisé)
ICARE_SETTINGS_FILE=config/settings.yaml
